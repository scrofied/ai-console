# 本机配置：含各工具绝对路径与个人环境，绝不提交
config/workers.json
config/settings.json

# 运行痕迹：事件流、作业记录、临时探针、截图、备份
console/events/
console/jobs/
console/plans/
console/tmp/
console/*.log
shared/daily-log.md
shared/daily-log.md.bak-*

# 各家 AI 的产出与验收（会随使用不断增长，不进仓库）
codex/
workbuddy/
workbuddyai/
qoder/
traework/
doubao/

# 任务与验收的工作区（保留模板即可，运行态不入库）
tasks/*.md
reviews/*.md

# 探测第三方包
probe/

# 归档
archive/

# 系统
.DS_Store
Thumbs.db
node_modules/

# 会话 id（本机运行时状态，绝不提交）
config/sessions.json

# 本机参谋席位配置（含本机头像路径），示例见 config/council.example.json
config/council.json

# 本机流程模板，示例见 config/flows.example.json
config/flows.json

# 附件与参谋头像（可能是私人照片）
intake/

# 事故排查留下的副本
console/*.corrupted
console/*.recovered-holes
console/*.repair*.ts
console/_base.ts
console/smoke.*.log

# 事故/备份副本
config/*.bak-*
console/*.bak-before-merge

# 本机预览图（正式图在 docs/screenshots/）
console/*-preview.png
console/council-faces.png
console/assets/table-sci-alt.png

# 本地工具脚本
_push_via_api.py

# 共享运行记录（工作日志会不断增长）
shared/
